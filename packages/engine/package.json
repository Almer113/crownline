{
  "name": "@crownline/engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The Crownline layout engine in TypeScript (PLAN Phase 5), checked against the Python engine",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./print": "./src/print.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@crownline/schema": "*",
    "playwright": "^1.65.1"
  }
}
