    "@crownline/ops": "*",
    "@crownline/schema": "*",
    "@modelcontextprotocol/server": "2.4.0",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
